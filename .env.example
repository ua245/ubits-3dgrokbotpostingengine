# Copy to .env and fill in. Never commit .env or tokens.json.

# ---- Filing cabinet + Publisher state -------------------------------------
GROKBOT_CABINET=./grokbot-cabinet
# PUBLISHER_STATE_DIR=./grokbot-cabinet/.publisher     # ledger, locks, media cache
# PUBLISHER_TOKENS_FILE=~/.config/grokbot-publisher/tokens.json
PUBLISHER_ENABLED_PLATFORMS=instagram,x,youtube,linkedin,tiktok
# trim = shorten over-long captions (noted in the report); strict = refuse instead
PUBLISHER_CAPTION_POLICY=trim
# PUBLISHER_LOG_FILE=./grokbot-cabinet/.publisher/publisher.log
# PUBLISHER_WATCH_INTERVAL=30

# Orchestrator callback: the report JSON is POSTed here after every run,
# signed with HMAC-SHA256 in the X-Grokbot-Signature header.
# PUBLISHER_REPORT_WEBHOOK_URL=
# PUBLISHER_REPORT_WEBHOOK_SECRET=

# ---- Temporary public storage (Instagram needs a public media URL) --------
# Cloudflare R2: endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto".
# Add a lifecycle rule on the bucket to delete objects under S3_PREFIX after 1 day.
STORAGE_BACKEND=s3
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=grokbot-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=grokbot-tmp/
S3_URL_EXPIRY=3600
# AWS S3 example: S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com  S3_REGION=eu-west-2  S3_ADDRESSING=virtual
# Or serve a folder through an https tunnel instead of a bucket:
# STORAGE_BACKEND=local
# LOCAL_PUBLIC_DIR=/srv/grokbot-public
# LOCAL_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# ---- Instagram (Business/Creator account, "Instagram API with Instagram Login")
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://ubits.tech/oauth/callback
# INSTAGRAM_API_HOST=graph.instagram.com     # graph.facebook.com for Facebook Login (can delete posts)
# INSTAGRAM_API_VERSION=v24.0

# ---- X (OAuth 2.0 user context, pay-per-use billing) -----------------------
X_CLIENT_ID=
X_CLIENT_SECRET=                               # leave empty for a public (PKCE-only) client
X_REDIRECT_URI=http://127.0.0.1:8765/callback
X_BLOCK_LINKS=false                            # true = refuse posts containing links (they cost ~13x more)
# X_MAX_VIDEO_SECONDS=140

# ---- YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled) ------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/callback
# YOUTUBE_CATEGORY_ID=28                       # Science & Technology

# ---- LinkedIn (app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://ubits.tech/oauth/callback
LINKEDIN_API_VERSION=202610
# LINKEDIN_ORG_URN=urn:li:organization:XXXX  # only after Community Management API approval

# ---- TikTok (Content Posting API, Direct Post) -----------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://ubits.tech/oauth/callback
TIKTOK_SOURCE=FILE_UPLOAD                      # PULL_FROM_URL needs a verified domain
